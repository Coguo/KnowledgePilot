# ===== DeepSeek LLM（OpenAI 兼容接口）=====
# 复制本文件为 .env，填入真实密钥。.env 已被 gitignore，不会上传仓库。
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 本地服务 =====
APP_HOST=127.0.0.1
APP_PORT=8000

# ===== 搜索服务商 =====
# 可选: stub（占位，不联网） / tavily（真实搜索，需注册 https://tavily.com 获取免费 key）
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-你的密钥

# ===== RAG（Phase 1，可选）=====
# 先安装: pip install -e ".[rag]"
# 开启后 search_web 会自动抓取搜索结果网页正文建库，并按向量检索给出带来源引用。
# 首次 embedding 会下载约 2GB 模型（本地 BGE-M3）；国内可设 HF_ENDPOINT=https://hf-mirror.com
RAG_ENABLED=false
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_CACHE_DIR=data/models
EMBEDDING_DEVICE=cpu
CHROMA_DIR=data/chroma
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=3
RAG_MAX_FETCH_URLS=3
RAG_FETCH_TIMEOUT=15

# ===== Agent 编排（Phase 3）=====
# agent_mode: graph（LangGraph：拆解→研究→评估→综合报告）/ loop（Phase 0-2 单轮工具循环）
AGENT_MODE=graph
# 研究-评估条件循环上限（防死循环；信息不足时会再研究，最多不超过该次数）
AGENT_MAX_ITERATIONS=3
# 单次研究的工具调用轮次上限（LLM 连续要工具、始终不给最终答案时的兜底）
AGENT_MAX_TOOL_ROUNDS=4
# 请求级轮数覆盖的硬上限：/api/chat 的请求体可带 max_iterations / max_tool_rounds
# 做单次精准查询，但会被钳到 [1, 该值]，防止请求端把服务拖死。只钳请求值，不钳上面两项。
AGENT_ROUNDS_HARD_CAP=10

# ===== RAG Optimization（Phase 2，可选旋钮）=====
# 分块策略: fixed（定长基线） / recursive（按自然边界递归切分）
RAG_CHUNK_STRATEGY=fixed
# BM25 + 向量 RRF 混合搜索（补向量漏检；需 rank-bm25，随 [rag] extra 安装）
RAG_HYBRID_ENABLED=true
# bge-reranker-base CrossEncoder 精排（首次启用需下载约 1.1GB 模型，
# 国内可设 HF_ENDPOINT=https://hf-mirror.com）
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_RERANK_CANDIDATES=20
# 查询改写（默认关：开启后每次 search_web 多一次 DeepSeek 调用）
RAG_QUERY_REWRITE_ENABLED=false

# ===== Memory（Phase 4，可选）=====
# 开启后：研究完成后 query/plan/report/来源 落库；下次同类问题自动召回历史，
# 注入规划流程复用（前端显示"找到 N 条历史研究记录"）；图 checkpoint 持久化
# （MemorySaver → SqliteSaver，需 langgraph-checkpoint-sqlite，随 base dependencies 安装）。
# 数据落在 data/ 下（已被 gitignore）。
MEMORY_ENABLED=true
MEMORY_DB_PATH=data/research_memory.db
MEMORY_CHECKPOINT_DB_PATH=data/graph_checkpoints.db
# 新研究开始时召回的历史研究条数
MEMORY_TOP_K=3

# ===== Knowledge Graph（Phase 5，可选）=====
# 开启后：研究结束前用 LLM 从已收集资料抽取实体与关系，建内存知识图谱；
# 按研究问题关键词匹配实体、BFS 展开关系，注入综合报告 prompt（结构化关系信息）。
# 零新依赖（纯 stdlib dict 邻接）；默认关向后兼容；只在 AGENT_MODE=graph 生效。
KG_ENABLED=true
# 从匹配实体 BFS 扩展的边层数（1 层 = 直接相连的关系；越大注入的关系越多）
KG_HOPS=2

# ===== MCP（Phase 6，可选）=====
# Agent 作为官方 mcp SDK 的 client，连接 stdio 子进程 server，把只读研究辅助能力
# 变成 LLM 可主动调用的工具。随 base dependencies 安装 mcp（1.x）。
# 开启后 research 循环多出：search_memory / recent_research（读上面 MEMORY_DB_PATH 的历史，
# 需先开启 MEMORY_ENABLED 积累历史）/ search_papers（arXiv 论文，无需 key）。
# search_web 保持原生进程内工具（证据采集 + RAG 增强依赖父进程结构化结果，不迁 MCP）。
# 默认关向后兼容；只在 AGENT_MODE=graph 生效。
MCP_ENABLED=false

# ===== 学习图谱（Phase 9）=====
# 产品形态从「一次性研究报告」转为「持久化学习伙伴」：每个主题新建一次研究 → 生成
# 学习路径知识图谱 → 逐个知识点讲解 → 系统推荐点亮 + 用户确认。学习进度与讲解正文
# 全部落盘，重启后直接读回，不重新检索。
# **默认开**：`/` 就是这个图谱界面——它是产品门面，不该由后端开关决定画不画。
# 「默认开」不等于「会花钱」：所有 GET 端点零 LLM 调用，不配 key 也能浏览已有图谱，
# 只有 create/generate/chat/mastery 才需要 key。设为 false 可退回纯研究聊天形态
# （此时 /api/learning/* 统一返回 503）。
# 零新依赖：结构与状态用 stdlib sqlite3，正文用 Markdown 文件。
LEARNING_ENABLED=true
# 主题 / 知识点 / 前置关系 / 学习状态 / 对话（SQLite）
LEARNING_DB_PATH=./data/learning.db
# 每个知识点的讲解正文（Markdown；可直接用编辑器打开、手写笔记）
# 注意：data/ 默认在 .gitignore 里。若想把学习记录纳入版本管理，二选一：
#   1) 在 .gitignore 里加白名单：!data/knowledge/
#   2) 把 LEARNING_NOTES_DIR 指到仓库外的目录（如 ~/knowledge）
LEARNING_NOTES_DIR=./data/knowledge
# 单主题知识点上限（LLM 抽多了会截断，防大图糊成一团）
LEARNING_MAX_NODES=12
# 讲解后是否让 LLM 判定「这个知识点可以点亮了吗」（判定失败一律不推荐，防误点亮）
LEARNING_RECOMMEND_ENABLED=true
# 至少聊够几轮才判定（省掉没必要的调用）
LEARNING_RECOMMEND_MIN_TURNS=1
# 推荐点亮的置信度阈值（低于此值不推荐；误推荐会污染「掌握」这个资产）
LEARNING_MASTERY_CONFIDENCE=0.7
# 打开知识点时是否自动开讲；默认 false = 只读已存正文，不发任何 LLM 请求
LEARNING_AUTO_EXPLAIN=false
# 打开节点时按需生成的提纲最多几条（默认 6；见 learning/outline.py）
LEARNING_OUTLINE_MAX_ITEMS=6

# ===== Model Gateway（Phase 8，可选；全部默认关/空 = 单 DeepSeek，行为与旧版一致）=====
# 统一模型访问层：超时 / 重试 / fallback / token usage 日志。默认关闭逐字节兼容，
# 只有需要传输加固时开启。重试仅作用于瞬时错误（连接/超时/429/5xx），400/401/403/404
# 等语义错误不重试、不 fallback。
# LLM_TIMEOUT 不设 = 用 SDK 默认超时；设为 60 表示 60 秒。
LLM_TIMEOUT=
# 网关自管重试：瞬时错误按 LLM_RETRY_MAX_ATTEMPTS 次、线性退避重试。
LLM_RETRY_ENABLED=false
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=1
# 主 DeepSeek 瞬时错重试耗尽后，顺延下面的 LLM_EXTRA_PROVIDERS（OpenAI 兼容）。
LLM_FALLBACK_ENABLED=false
# 记录每次 LLM 调用的 token usage 到 stderr 日志（不污染 SSE 的 stdout）。
LLM_LOG_USAGE=false
# fallback 目标（JSON 数组，OpenAI 兼容接口，如 Qwen）。默认空 → 无 fallback。
# 例：
# LLM_EXTRA_PROVIDERS=[{"name":"qwen","model":"qwen-plus","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key":"sk-你的密钥","timeout":60}]
LLM_EXTRA_PROVIDERS=
