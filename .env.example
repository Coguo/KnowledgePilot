# ===== DeepSeek LLM（OpenAI 兼容接口）=====
# 复制本文件为 .env，填入真实密钥。.env 已被 gitignore，不会上传仓库。
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 本地服务 =====
APP_HOST=127.0.0.1
APP_PORT=8000

# ===== 搜索服务商 =====
# 可选: stub（占位，不联网） / tavily（真实搜索，需注册 https://tavily.com 获取免费 key）
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-你的密钥

# ===== RAG（Phase 1，可选）=====
# 先安装: pip install -e ".[rag]"
# 开启后 search_web 会自动抓取搜索结果网页正文建库，并按向量检索给出带来源引用。
# 首次 embedding 会下载约 2GB 模型（本地 BGE-M3）；国内可设 HF_ENDPOINT=https://hf-mirror.com
RAG_ENABLED=false
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_CACHE_DIR=data/models
EMBEDDING_DEVICE=cpu
CHROMA_DIR=data/chroma
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=3
RAG_MAX_FETCH_URLS=3
RAG_FETCH_TIMEOUT=15

# ===== RAG Optimization（Phase 2，可选旋钮）=====
# 分块策略: fixed（定长基线） / recursive（按自然边界递归切分）
RAG_CHUNK_STRATEGY=fixed
# BM25 + 向量 RRF 混合搜索（补向量漏检；需 rank-bm25，随 [rag] extra 安装）
RAG_HYBRID_ENABLED=true
# bge-reranker-base CrossEncoder 精排（首次启用需下载约 1.1GB 模型，
# 国内可设 HF_ENDPOINT=https://hf-mirror.com）
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_RERANK_CANDIDATES=20
# 查询改写（默认关：开启后每次 search_web 多一次 DeepSeek 调用）
RAG_QUERY_REWRITE_ENABLED=false
