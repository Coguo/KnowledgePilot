# ===== DeepSeek LLM（OpenAI 兼容接口）=====
# 复制本文件为 .env，填入真实密钥。.env 已被 gitignore，不会上传仓库。
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 本地服务 =====
APP_HOST=127.0.0.1
APP_PORT=8000

# ===== 搜索服务商 =====
# 当前仅支持 stub（固定占位结果，不联网）。接入 Tavily / DuckDuckGo / Brave 时在此切换。
SEARCH_PROVIDER=stub
